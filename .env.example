# Template only. Local non-production startup loads .env; production secrets must be injected.
# Production startup intentionally ignores .env and requires NODE_ENV=production from the supervisor.
NODE_ENV=production
HOST=127.0.0.1
PORT=8080

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_CREDENTIAL_1_ENABLED=false
GEMINI_CREDENTIAL_2_ENABLED=false
GEMINI_CREDENTIAL_3_ENABLED=false
GEMINI_CREDENTIAL_4_ENABLED=false
GEMINI_CREDENTIAL_5_ENABLED=false
GEMINI_CREDENTIAL_6_ENABLED=false
GEMINI_CREDENTIAL_7_ENABLED=false
GEMINI_CREDENTIAL_8_ENABLED=false
GEMINI_CREDENTIAL_9_ENABLED=false
GEMINI_CREDENTIAL_10_ENABLED=false

KIARA_GEMINI_PROJECT_ID=
KIARA_LIVE_SYSTEM_INSTRUCTION_SHA256=
KIARA_GATEWAY_HMAC_SECRET=
KIARA_GATEWAY_HMAC_PREVIOUS_SECRET=
REDIS_URL=rediss://<user>:<password>@<private-redis-host>:<port>/<db>
KIARA_REDIS_CA_CERT_FILE=
KIARA_GATEWAY_MAX_CONCURRENT=5
KIARA_PROJECT_REQUESTS_PER_MINUTE=60
KIARA_PROJECT_QUOTA_COOLDOWN_MS=60000
KIARA_GATEWAY_PROVIDER_TIMEOUT_MS=10000
